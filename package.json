{
  "name": "atlas-studio",
  "productName": "Atlas Studio",
  "version": "1.5.4",
  "description": "Atlas Studio — Sistema de roteiros com IA",
  "private": true,
  "main": "dist-electron/main.js",
  "author": "Atlas Studio",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/MathiasGFuhr/atlas-studio.git"
  },
  "homepage": "https://github.com/MathiasGFuhr/atlas-studio",
  "bugs": {
    "url": "https://github.com/MathiasGFuhr/atlas-studio/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "vitest run",
    "electron:dev": "vite",
    "electron:build": "npm run build && electron-builder --win --publish never",
    "electron:release": "npm run build && electron-builder --win --publish always",
    "codex:status": "npm run build && node scripts/check-codex-status.mjs",
    "test:e2e": "npm run build && node scripts/run-e2e.mjs",
    "postinstall": "node scripts/patch-electron-plugin.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.9",
    "ffmpeg-static": "^5.3.0",
    "lucide-react": "^0.544.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2",
    "sql.js": "^1.13.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@tailwindcss/vite": "^4.1.13",
    "@types/node": "^22.18.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^5.0.2",
    "electron": "^37.3.1",
    "electron-builder": "^26.0.12",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vite": "^7.1.4",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^3.2.7"
  },
  "build": {
    "appId": "com.atlasstudio.app",
    "productName": "Atlas Studio",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "!node_modules/ffmpeg-static/**"
    ],
    "extraResources": [
      {
        "from": "workspace",
        "to": "workspace"
      },
      {
        "from": "resources/sql-wasm.wasm",
        "to": "sql-wasm.wasm"
      },
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "node_modules/ffmpeg-static/ffmpeg.exe",
        "to": "ffmpeg.exe"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "AtlasStudio-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Atlas Studio",
      "uninstallDisplayName": "Atlas Studio",
      "deleteAppDataOnUninstall": false
    },
    "publish": {
      "provider": "github",
      "owner": "MathiasGFuhr",
      "repo": "atlas-studio",
      "private": false,
      "releaseType": "release",
      "vPrefixedTagName": true
    }
  }
}
