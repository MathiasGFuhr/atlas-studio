{
  "manifest_version": 3,
  "name": "Atlas Flow Bridge",
  "version": "1.0.43",
  "description": "Conecta o Atlas Studio ao Google Flow para criar projetos e enviar imagens de referência (sem pedir senha).",
  "permissions": ["storage", "tabs", "windows", "scripting", "alarms", "debugger"],
  "host_permissions": [
    "http://127.0.0.1/*",
    "https://flow.google.com/*",
    "https://labs.google/*",
    "https://accounts.google.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Atlas Flow Bridge",
    "default_popup": "popup.html"
  },
  "web_accessible_resources": [
    {
      "resources": ["pageUpload.js"],
      "matches": [
        "https://flow.google.com/*",
        "https://labs.google/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://flow.google.com/*",
        "https://labs.google/*/tools/flow*",
        "https://labs.google/fx/tools/flow*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
